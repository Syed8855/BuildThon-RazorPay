    "time_since_last_attempt",
    "time_since_first_failure",
    "failure_reason",
    "is_near_payday",
    "payment_method",
    "is_recurring",
    "merchant_category",
    "customer_segment",
    "customer_historical_failure_rate",
    "amount"
  ],
  "cat_cols": [
